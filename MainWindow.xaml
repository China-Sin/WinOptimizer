<Window x:Class="WinOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinOptimizer — Windows 一键系统优化与开发环境部署工具"
        Width="1040" Height="680"
        MinWidth="820" MinHeight="500"
        WindowStartupLocation="Manual"
        Background="{StaticResource BgApp}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Microsoft YaHei UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航栏 -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True" Margin="14,14,14,12">
                <!-- 软件标题 Logo 区（按住可拖动窗口） -->
                <StackPanel DockPanel.Dock="Top" Margin="6,0,6,14" Background="Transparent" MouseLeftButtonDown="HeaderArea_MouseLeftButtonDown" Cursor="SizeAll">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="8" Background="#2563EB" Margin="0,0,10,0">
                            <TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="WinOptimizer" FontSize="16" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="模块化一键优化中心 v1.2" FontSize="11" Foreground="{StaticResource TextMuted}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 底部系统信息与常用快捷工具 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Style="{StaticResource SecondaryBtn}" Command="{Binding PurgeStandbyRamCommand}" Margin="0,0,0,6" HorizontalContentAlignment="Center"
                            ToolTip="调用原生 NtSetSystemInformation 秒清系统堆积的备用缓存内存（打永劫前或连玩几局后点一下防掉帧）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" Foreground="#34D399" VerticalAlignment="Center" Margin="0,0,7,0" FontSize="12" />
                            <TextBlock Text="秒清备用内存 (ISLC)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryBtn}" Command="{Binding CleanShaderCacheCommand}" Margin="0,0,0,6" HorizontalContentAlignment="Center"
                            ToolTip="安全清理 DXCache / GLCache / D3DSCache 中未被占用的旧版着色器缓存（更新显卡驱动或游戏赛季更新后推荐使用）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="#60A5FA" VerticalAlignment="Center" Margin="0,0,7,0" FontSize="12" />
                            <TextBlock Text="清理旧着色器缓存" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryBtn}" Command="{Binding RestartExplorerCommand}" Margin="0,0,0,8" HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,7,0" FontSize="12" />
                            <TextBlock Text="重启资源管理器" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Background="#10131B" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="7" Padding="10,7">
                        <StackPanel>
                            <TextBlock Text="{Binding OsSummary}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                            <TextBlock Text="● 管理员权限运行中" FontSize="11" Foreground="#34D399" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 中间可滚动导航列表（小屏高缩放时永不挤压） -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 分类组 1：系统优化 -->
                        <TextBlock Text="系统优化 (TWEAKS)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="10,0,0,5" />

                        <RadioButton GroupName="MainSidebarNav" Style="{StaticResource NavRadioStyle}" IsChecked="True"
                                     Command="{Binding NavigateCommand}" CommandParameter="ALL_TWEAKS">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="全部系统优化" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="MainSidebarNav" Style="{StaticResource NavRadioStyle}"
                                     Command="{Binding NavigateCommand}" CommandParameter="CAT_GAMING">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="游戏与低延迟" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="MainSidebarNav" Style="{StaticResource NavRadioStyle}"
                                     Command="{Binding NavigateCommand}" CommandParameter="CAT_PERFORMANCE">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="性能与电源" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="MainSidebarNav" Style="{StaticResource NavRadioStyle}"
                                     Command="{Binding NavigateCommand}" CommandParameter="CAT_SECURITY">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="安全与防火墙" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="MainSidebarNav" Style="{StaticResource NavRadioStyle}"
                                     Command="{Binding NavigateCommand}" CommandParameter="CAT_DESKTOP">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="桌面与右键菜单" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="MainSidebarNav" Style="{StaticResource NavRadioStyle}"
                                     Command="{Binding NavigateCommand}" CommandParameter="CAT_UPDATE">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="系统更新控制" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="6,10" />

                        <!-- 分类组 2：环境安装与右键管理 -->
                        <TextBlock Text="扩展与定制管理 (TOOLS)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="10,0,0,5" />

                        <RadioButton GroupName="MainSidebarNav" Style="{StaticResource NavRadioStyle}"
                                     Command="{Binding NavigateCommand}" CommandParameter="CTX_MENU">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="右键菜单管理" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="MainSidebarNav" Style="{StaticResource NavRadioStyle}"
                                     Command="{Binding NavigateCommand}" CommandParameter="STARTUP_MGR">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="开机启动项管理" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="MainSidebarNav" Style="{StaticResource NavRadioStyle}"
                                     Command="{Binding NavigateCommand}" CommandParameter="ENV_ALL">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="开发环境安装" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 右侧主工作区 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="155" />
            </Grid.RowDefinitions>

            <!-- 顶部标题与批量操作栏（空白处按住可直接拖动窗口） -->
            <Border Grid.Row="0" Padding="24,14,24,12" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1"
                    Background="Transparent" MouseLeftButtonDown="HeaderArea_MouseLeftButtonDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 第一行：标题 + 搜索框 -->
                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="{Binding PageHeaderTitle}" FontSize="20" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="{Binding PageHeaderSubtitle}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                        </StackPanel>

                        <Border DockPanel.Dock="Right" Width="230" Height="34" VerticalAlignment="Top" Background="#161A25" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" />
                                <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                                         VerticalContentAlignment="Center" FontSize="12.5" />
                                <TextBlock Grid.Column="1" Text="搜索功能或环境名称..." Foreground="{StaticResource TextMuted}" FontSize="12"
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DockPanel>

                    <!-- 第二行：上下文批量操作按钮栏 + 右侧已优化/未优化状态筛选器 -->
                    <DockPanel Grid.Row="1" Margin="0,14,0,0" LastChildFill="True">
                        <!-- 右侧状态筛选分段胶囊（已优化 / 未优化 / 已安装 / 未安装） -->
                        <Grid DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Border Visibility="{Binding IsTweaksView, Converter={StaticResource BoolToVis}}"
                                    Background="#151924" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="7" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="TweaksStatusGroup" Style="{StaticResource FilterPillRadioStyle}" IsChecked="True"
                                                 Content="{Binding FilterAllTweaksLabel}"
                                                 Command="{Binding SetStatusFilterCommand}" CommandParameter="ALL" />
                                    <RadioButton GroupName="TweaksStatusGroup" Style="{StaticResource FilterPillRadioStyle}"
                                                 Content="{Binding FilterOptimizedTweaksLabel}"
                                                 Command="{Binding SetStatusFilterCommand}" CommandParameter="OPTIMIZED" />
                                    <RadioButton GroupName="TweaksStatusGroup" Style="{StaticResource FilterPillRadioStyle}"
                                                 Content="{Binding FilterUnoptimizedTweaksLabel}"
                                                 Command="{Binding SetStatusFilterCommand}" CommandParameter="UNOPTIMIZED" />
                                </StackPanel>
                            </Border>

                            <Border Visibility="{Binding IsEnvView, Converter={StaticResource BoolToVis}}"
                                    Background="#151924" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="7" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="EnvsStatusGroup" Style="{StaticResource FilterPillRadioStyle}" IsChecked="True"
                                                 Content="{Binding FilterAllEnvsLabel}"
                                                 Command="{Binding SetStatusFilterCommand}" CommandParameter="ALL" />
                                    <RadioButton GroupName="EnvsStatusGroup" Style="{StaticResource FilterPillRadioStyle}"
                                                 Content="{Binding FilterInstalledEnvsLabel}"
                                                 Command="{Binding SetStatusFilterCommand}" CommandParameter="OPTIMIZED" />
                                    <RadioButton GroupName="EnvsStatusGroup" Style="{StaticResource FilterPillRadioStyle}"
                                                 Content="{Binding FilterUninstalledEnvsLabel}"
                                                 Command="{Binding SetStatusFilterCommand}" CommandParameter="UNOPTIMIZED" />
                                </StackPanel>
                            </Border>

                            <Border Visibility="{Binding IsContextMenuView, Converter={StaticResource BoolToVis}}"
                                    Background="#151924" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="7" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="CtxScopeGroup" Style="{StaticResource FilterPillRadioStyle}" IsChecked="True"
                                                 Content="桌面空白处"
                                                 Command="{Binding SetCtxScopeFilterCommand}" CommandParameter="DESKTOP" />
                                    <RadioButton GroupName="CtxScopeGroup" Style="{StaticResource FilterPillRadioStyle}"
                                                 Content="文件 (*)"
                                                 Command="{Binding SetCtxScopeFilterCommand}" CommandParameter="FILE" />
                                    <RadioButton GroupName="CtxScopeGroup" Style="{StaticResource FilterPillRadioStyle}"
                                                 Content="文件夹"
                                                 Command="{Binding SetCtxScopeFilterCommand}" CommandParameter="FOLDER" />
                                    <RadioButton GroupName="CtxScopeGroup" Style="{StaticResource FilterPillRadioStyle}"
                                                 Content="驱动器"
                                                 Command="{Binding SetCtxScopeFilterCommand}" CommandParameter="DRIVE" />
                                    <RadioButton GroupName="CtxScopeGroup" Style="{StaticResource FilterPillRadioStyle}"
                                                 Content="全部"
                                                 Command="{Binding SetCtxScopeFilterCommand}" CommandParameter="ALL" />
                                </StackPanel>
                            </Border>

                            <Border Visibility="{Binding IsStartupView, Converter={StaticResource BoolToVis}}"
                                    Background="#151924" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="7" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="StartupStatusGroup" Style="{StaticResource FilterPillRadioStyle}" IsChecked="True"
                                                 Content="{Binding FilterAllStartupsLabel}"
                                                 Command="{Binding SetStartupFilterCommand}" CommandParameter="ALL" />
                                    <RadioButton GroupName="StartupStatusGroup" Style="{StaticResource FilterPillRadioStyle}"
                                                 Content="{Binding FilterEnabledStartupsLabel}"
                                                 Command="{Binding SetStartupFilterCommand}" CommandParameter="ENABLED" />
                                    <RadioButton GroupName="StartupStatusGroup" Style="{StaticResource FilterPillRadioStyle}"
                                                 Content="{Binding FilterDisabledStartupsLabel}"
                                                 Command="{Binding SetStartupFilterCommand}" CommandParameter="DISABLED" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 左侧批量按钮区 -->
                        <Grid>
                            <!-- 系统优化模式的工具栏 -->
                            <WrapPanel Visibility="{Binding IsTweaksView, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource PrimaryBtn}" Command="{Binding ApplySelectedTweaksCommand}" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="一键优化勾选项" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryBtn}" Command="{Binding SelectUnoptimizedTweaksCommand}" Margin="0,0,8,0" Content="勾选未优化项" />
                                <Button Style="{StaticResource SecondaryBtn}" Command="{Binding SelectAllTweaksCommand}" Margin="0,0,8,0" Content="全选 / 取消" />
                                <Button Style="{StaticResource SecondaryBtn}" Command="{Binding RevertSelectedTweaksCommand}" Margin="0,0,8,0" Content="批量恢复默认" />
                                <Button Style="{StaticResource SecondaryBtn}" Command="{Binding RefreshAllCommand}" Content="刷新状态" />
                            </WrapPanel>

                            <!-- 开发环境模式的工具栏 -->
                            <WrapPanel Visibility="{Binding IsEnvView, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource PrimaryBtn}" Command="{Binding InstallSelectedEnvsCommand}" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="一键安装勾选环境" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryBtn}" Command="{Binding SelectRecommendedEnvsCommand}" Margin="0,0,8,0" Content="勾选全部未安装环境" />
                                <Button Style="{StaticResource SecondaryBtn}" Command="{Binding RefreshAllCommand}" Content="刷新版本检测" />
                            </WrapPanel>

                            <!-- 右键菜单管理模式的工具栏 -->
                            <WrapPanel Visibility="{Binding IsContextMenuView, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource PrimaryBtn}" Command="{Binding HideSelectedContextMenusCommand}" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xED1A;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="一键隐藏勾选项" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryBtn}" Command="{Binding EnableSelectedContextMenusCommand}" Margin="0,0,8,0" Content="批量恢复显示" />
                                <Button Style="{StaticResource SecondaryBtn}" Command="{Binding RefreshAllCommand}" Content="重新扫描右键" />
                            </WrapPanel>

                            <!-- 开机启动项管理模式的工具栏 -->
                            <WrapPanel Visibility="{Binding IsStartupView, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource PrimaryBtn}" Command="{Binding DisableSelectedStartupsCommand}" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="一键禁用勾选项" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryBtn}" Command="{Binding EnableSelectedStartupsCommand}" Margin="0,0,8,0" Content="批量允许自启" />
                                <Button Style="{StaticResource SecondaryBtn}" Command="{Binding RefreshAllCommand}" Content="重新扫描启动项" />
                            </WrapPanel>
                        </Grid>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- 动态生效提示横幅区（重启电脑 / 重启资源管理器） -->
            <StackPanel Grid.Row="1">
                <!-- 1. 需要重启电脑的醒目横幅 -->
                <Border Visibility="{Binding ShowSystemRebootBanner, Converter={StaticResource BoolToVis}}"
                        Background="#361B18" BorderBrush="#993B2F" BorderThickness="0,0,0,1" Padding="24,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Style="{StaticResource PrimaryBtn}" Background="#DC2626" Command="{Binding RebootComputerCommand}" Content="立即重启电脑" Padding="10,4" FontSize="12" Margin="0,0,8,0" />
                            <Button Style="{StaticResource SecondaryBtn}" Command="{Binding DismissRebootBannerCommand}" Content="稍后重启" Padding="9,4" FontSize="12" />
                        </StackPanel>
                        <TextBlock Text="{Binding SystemRebootBannerText}" TextWrapping="Wrap"
                                   Foreground="#FCA5A5" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- 2. 需要重启资源管理器的提示横幅 -->
                <Border Visibility="{Binding ShowExplorerRestartBanner, Converter={StaticResource BoolToVis}}"
                        Background="#2B2112" BorderBrush="#6B4E1B" BorderThickness="0,0,0,1" Padding="24,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Style="{StaticResource SecondaryBtn}" Command="{Binding RestartExplorerCommand}" Content="立即重启资源管理器" Padding="10,4" FontSize="12" Margin="0,0,8,0" />
                            <Button Style="{StaticResource SecondaryBtn}" Command="{Binding DismissExplorerBannerCommand}" Content="忽略" Padding="8,4" FontSize="12" />
                        </StackPanel>
                        <TextBlock Text="提示：桌面 / 右键菜单 / 开始菜单等壳层设置已变更（开启或关闭均需重启资源管理器后立即生效）。" TextWrapping="Wrap"
                                   Foreground="#FBBF24" FontSize="12.5" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- 中部滚动卡片列表区 -->
            <Grid Grid.Row="2">
                <!-- 1. 系统优化卡片列表 -->
                <ScrollViewer Visibility="{Binding IsTweaksView, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto" Padding="24,14,24,14">
                    <ItemsControl ItemsSource="{Binding FilteredTweaks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                        CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 批量勾选框 -->
                                        <CheckBox Grid.Column="0" Style="{StaticResource ModernCheckBox}"
                                                  IsChecked="{Binding IsSelectedForBatch}" Margin="0,0,14,0" />

                                        <!-- 功能图标 -->
                                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="8" Background="#232A3B" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#60A5FA"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- 标题与详细描述 -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <WrapPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,2" />
                                                <Border Background="#232B3E" CornerRadius="4" Padding="6,2" Margin="0,0,6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Category}" FontSize="10.5" Foreground="#93C5FD" />
                                                </Border>
                                                <Border Visibility="{Binding IsSystemRebootRequired, Converter={StaticResource BoolToVis}}"
                                                        Background="#3A2116" BorderBrush="#7C3A1D" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,6,2" VerticalAlignment="Center"
                                                        ToolTip="此项开启或关闭（恢复默认）后，均需重启电脑才能完全生效">
                                                    <TextBlock Text="需重启电脑" FontSize="10.5" FontWeight="SemiBold" Foreground="#FDBA74" />
                                                </Border>
                                                <Border Visibility="{Binding IsExplorerRestartRequired, Converter={StaticResource BoolToVis}}"
                                                        Background="#152B3C" BorderBrush="#1E4D6B" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,6,2" VerticalAlignment="Center"
                                                        ToolTip="此项开启或关闭（恢复默认）后，需重启资源管理器才能生效">
                                                    <TextBlock Text="需重启资源管理器" FontSize="10.5" FontWeight="SemiBold" Foreground="#7DD3FC" />
                                                </Border>
                                                <Border Visibility="{Binding IsInstantEffect, Converter={StaticResource BoolToVis}}"
                                                        Background="#1A2230" BorderBrush="#2A3548" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,6,2" VerticalAlignment="Center"
                                                        ToolTip="此项开启或关闭后即时生效，无需重启">
                                                    <TextBlock Text="即时生效" FontSize="10.5" Foreground="#94A3B8" />
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding TechnicalDetail}" FontSize="11" Foreground="{StaticResource TextMuted}"
                                                       FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <!-- 实时状态徽章 -->
                                        <Border Grid.Column="3" VerticalAlignment="Center" CornerRadius="6" Padding="10,4" Margin="0,0,14,0" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#232836" />
                                                    <Setter Property="BorderBrush" Value="#333B4F" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOptimized}" Value="True">
                                                            <Setter Property="Background" Value="#122D23" />
                                                            <Setter Property="BorderBrush" Value="#1F513D" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusBadgeText}" FontSize="11.5" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOptimized}" Value="True">
                                                                <Setter Property="Foreground" Value="#34D399" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- 胶囊状态切换开关 -->
                                        <Button Grid.Column="4" Style="{StaticResource PillToggleButtonStyle}"
                                                ToolTip="点击立即切换优化开启 / 恢复系统默认"
                                                Command="{Binding DataContext.ToggleSingleTweakCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 2. 开发环境与工具安装卡片列表 -->
                <ScrollViewer Visibility="{Binding IsEnvView, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto" Padding="24,14,24,14">
                    <ItemsControl ItemsSource="{Binding FilteredEnvs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                        CornerRadius="10" Padding="16,13" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" Style="{StaticResource ModernCheckBox}"
                                                  IsChecked="{Binding IsSelectedForBatch}" Margin="0,0,14,0" />

                                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="8" Background="#232A3B" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#38BDF8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                                <Border Background="#232B3E" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Category}" FontSize="10.5" Foreground="#93C5FD" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding WingetId}" FontSize="11" Foreground="{StaticResource TextMuted}"
                                                       FontFamily="Consolas" Margin="0,3,0,0" />
                                        </StackPanel>

                                        <!-- 已安装版本徽章 -->
                                        <Border Grid.Column="3" VerticalAlignment="Center" CornerRadius="6" Padding="10,4" Margin="0,0,12,0" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#232836" />
                                                    <Setter Property="BorderBrush" Value="#333B4F" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                            <Setter Property="Background" Value="#122D23" />
                                                            <Setter Property="BorderBrush" Value="#1F513D" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding VersionBadgeText}" FontSize="11.5" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                <Setter Property="Foreground" Value="#34D399" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- 单项安装 / 升级 / 卸载按钮 -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SecondaryBtn}" Content="{Binding PrimaryActionText}"
                                                    Command="{Binding DataContext.InstallOrUpgradeSingleEnvCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Padding="12,5" />
                                            <Button Style="{StaticResource SecondaryBtn}" Content="卸载" Margin="6,0,0,0" Padding="9,5"
                                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.UninstallSingleEnvCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 3. 右键菜单自定义管理卡片列表 -->
                <ScrollViewer Visibility="{Binding IsContextMenuView, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto" Padding="24,14,24,14">
                    <ItemsControl ItemsSource="{Binding FilteredContextMenus}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                        CornerRadius="10" Padding="16,12" Margin="0,0,0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" Style="{StaticResource ModernCheckBox}"
                                                  IsChecked="{Binding IsSelectedForBatch}" Margin="0,0,14,0" />

                                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" Background="#232A3B" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#A78BFA"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                                <Border Background="#232B3E" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ScopeLabel}" FontSize="10.5" Foreground="#93C5FD" />
                                                </Border>
                                                <Border Background="#1F2433" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding KindLabel}" FontSize="10.5" Foreground="#CBD5E1" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding FullRegistryPath}" FontSize="11" Foreground="{StaticResource TextMuted}"
                                                       FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <!-- 显示/隐藏状态徽章 -->
                                        <Border Grid.Column="3" VerticalAlignment="Center" CornerRadius="6" Padding="10,4" Margin="0,0,12,0" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#232836" />
                                                    <Setter Property="BorderBrush" Value="#333B4F" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMenuEnabled}" Value="True">
                                                            <Setter Property="Background" Value="#122D23" />
                                                            <Setter Property="BorderBrush" Value="#1F513D" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusBadgeText}" FontSize="11.5" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMenuEnabled}" Value="True">
                                                                <Setter Property="Foreground" Value="#34D399" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- 无损隐藏/显示胶囊开关 -->
                                        <Button Grid.Column="4" Style="{StaticResource ContextMenuToggleStyle}"
                                                ToolTip="开启 = 在右键菜单中显示；关闭 = 无损隐藏（随时可重新打开）"
                                                Command="{Binding DataContext.ToggleSingleContextMenuCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />

                                        <!-- 第三方项彻底删除按钮（系统核心项自动隐藏防误删） -->
                                        <Button Grid.Column="5" Style="{StaticResource SecondaryBtn}" Content="删除" Margin="8,0,0,0" Padding="9,4" FontSize="11.5"
                                                Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                                                ToolTip="永久删除此第三方右键注册表项（带二次确认）"
                                                Command="{Binding DataContext.DeleteSingleContextMenuCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 4. 开机启动项管理卡片列表 -->
                <ScrollViewer Visibility="{Binding IsStartupView, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto" Padding="24,14,24,14">
                    <ItemsControl ItemsSource="{Binding FilteredStartupItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                        CornerRadius="10" Padding="16,12" Margin="0,0,0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" Style="{StaticResource ModernCheckBox}"
                                                  IsChecked="{Binding IsSelectedForBatch}" Margin="0,0,14,0" />

                                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" Background="#232A3B" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#34D399"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                                <Border Background="#232B3E" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SourceLabel}" FontSize="10.5" Foreground="#93C5FD" />
                                                </Border>
                                                <Border Visibility="{Binding TargetFileMissing, Converter={StaticResource BoolToVis}}"
                                                        Background="#3B2314" BorderBrush="#7C3F19" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="目标文件已丢失（残留）" FontSize="10.5" Foreground="#FBBF24" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Command}" FontSize="11" Foreground="{StaticResource TextMuted}"
                                                       FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                                                       ToolTip="{Binding Command}" />
                                        </StackPanel>

                                        <!-- 开机自启 / 已禁用徽章 -->
                                        <Border Grid.Column="3" VerticalAlignment="Center" CornerRadius="6" Padding="10,4" Margin="0,0,12,0" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#232836" />
                                                    <Setter Property="BorderBrush" Value="#333B4F" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStartupEnabled}" Value="True">
                                                            <Setter Property="Background" Value="#122D23" />
                                                            <Setter Property="BorderBrush" Value="#1F513D" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusBadgeText}" FontSize="11.5" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStartupEnabled}" Value="True">
                                                                <Setter Property="Foreground" Value="#34D399" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- 与任务管理器同步的无损开关 -->
                                        <Button Grid.Column="4" Style="{StaticResource StartupToggleStyle}"
                                                ToolTip="开启 = 允许开机自动启动；关闭 = 无损禁用（与 Windows 任务管理器完全同步）"
                                                Command="{Binding DataContext.ToggleSingleStartupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />

                                        <!-- 定位源文件 & 永久删除残留项 -->
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <Button Style="{StaticResource SecondaryBtn}" Content="定位" Padding="8,4" FontSize="11.5"
                                                    Visibility="{Binding CanLocate, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="在文件资源管理器中选中该启动项对应的程序文件"
                                                    Command="{Binding DataContext.LocateStartupFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource SecondaryBtn}" Content="删除" Margin="6,0,0,0" Padding="8,4" FontSize="11.5"
                                                    ToolTip="从注册表或启动文件夹永久删除此自启项（带二次确认）"
                                                    Command="{Binding DataContext.DeleteSingleStartupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 底部实时终端日志面板 -->
            <Border Grid.Row="3" Background="{StaticResource BgConsole}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="18,10,18,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 顶部状态标题行 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" Foreground="#60A5FA" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" />
                        <TextBlock Text="实时执行日志 (Execution Console)" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                        <ProgressBar Width="90" Height="4" IsIndeterminate="True" Margin="14,0,0,0" VerticalAlignment="Center"
                                     Foreground="{StaticResource AccentBlue}" Background="#1E293B" BorderThickness="0"
                                     Visibility="{Binding IsGlobalBusy, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- 中部日志文本滚动区 -->
                    <TextBox x:Name="ConsoleLogBox" Grid.Row="1"
                             Text="{Binding LogText, Mode=OneWay}"
                             IsReadOnly="True"
                             Background="Transparent"
                             Foreground="#A7F3D0"
                             BorderThickness="0"
                             Padding="0,2,4,2"
                             FontFamily="Consolas, Microsoft YaHei UI"
                             FontSize="12"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             TextChanged="ConsoleLogBox_TextChanged" />

                    <!-- 最底部右侧：清空日志按钮 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Style="{StaticResource SecondaryBtn}" Command="{Binding ClearLogCommand}"
                                Content="清空日志" Padding="12,3" FontSize="11.5" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
